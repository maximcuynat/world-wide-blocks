#!/usr/bin/env bash
# Avant chaque push : compile, lance les tests unitaires puis les tests en jeu, et refuse le push en cas d'échec.
#   ./gradlew build test
#   ./gradlew runGameTestServer
# Les tests sont sautés seulement si tous les fichiers des commits envoyés sont des .md ou sont dans docs/.
# Les tests portent sur l'arbre de travail : il doit être propre et le commit envoyé doit être HEAD.
set -euo pipefail

remote="$1"
zero='^0+$'

cd "$(git rev-parse --show-toplevel)"

# git donne une ligne par référence envoyée : <réf locale> <sha local> <réf distante> <sha distant>.
pushed_commits=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref:-}" ] && continue
    # Suppression d'une référence distante : rien à tester.
    if printf '%s' "$local_sha" | grep -q -E "$zero"; then
        continue
    fi
    # Un tag annoté désigne un objet tag : on teste le commit qu'il désigne.
    commit="$(git rev-parse "${local_sha}^{commit}")"
    pushed_commits="$pushed_commits $commit"
done

if [ -z "$pushed_commits" ]; then
    exit 0
fi

# Fichiers touchés par les commits qui ne sont encore sur aucune branche de ce dépôt distant.
# Pour une fusion, on compte ce qu'elle apporte à son premier parent.
changed_files="$(git log --format= --name-only --diff-merges=first-parent $pushed_commits --not --remotes="$remote" | sort -u | sed '/^$/d')"

if [ -z "$changed_files" ]; then
    echo "pre-push : aucun commit nouveau pour $remote, tests sautés."
    exit 0
fi

needs_tests=0
while IFS= read -r file; do
    case "$file" in
        *.md | docs/*) ;;
        *) needs_tests=1; break ;;
    esac
done <<EOF
$changed_files
EOF

if [ "$needs_tests" -eq 0 ]; then
    echo "pre-push : seulement des .md ou des fichiers de docs/, tests sautés."
    exit 0
fi

# Les tests tournent sur l'arbre de travail : il doit correspondre exactement à ce qui est envoyé.
if [ -n "$(git status --porcelain)" ]; then
    cat >&2 <<'EOF'
pre-push : l'arbre de travail n'est pas propre (modifications ou fichiers non suivis).
Les tests porteraient sur autre chose que ce qui est envoyé. Commitez ou mettez de côté (git stash -u), puis relancez le push.
EOF
    exit 1
fi

head="$(git rev-parse HEAD)"
for commit in $pushed_commits; do
    if [ "$commit" != "$head" ]; then
        cat >&2 <<EOF
pre-push : le commit envoyé ($commit) n'est pas HEAD ($head).
Placez-vous sur ce que vous envoyez (git switch <branche>) pour qu'il soit testé, puis relancez le push.
EOF
        exit 1
    fi
done

echo "pre-push : ./gradlew build test"
if ! ./gradlew build test; then
    echo "pre-push : build ou tests unitaires en échec, push refusé." >&2
    exit 1
fi

echo "pre-push : ./gradlew runGameTestServer"
if ! ./gradlew runGameTestServer; then
    echo "pre-push : tests en jeu en échec, push refusé (détail dans run-gametest/logs/latest.log)." >&2
    exit 1
fi

echo "pre-push : build, tests unitaires et tests en jeu au vert."
